{
  "manifest_version": 3,
  "name": "AI简历填表助手",
  "version": "1.2.0",
  "description": "维护 Markdown 个人资料，AI按网页需求生成填写内容，缺失事实提示补充（不自动提交）",
  "minimum_chrome_version": "114",
  "permissions": [
    "storage",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": ["http://*/*", "https://*/*"],
  "action": {
    "default_icon": {
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "128": "icons/icon128.png"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
